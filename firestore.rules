rules_version = '2';

// Derstayım – English Time yoklama kuralları.
// Uygulama kodu ne yaparsa yapsın, bu kurallar Google sunucusunda çalışır;
// öğrenci tarayıcıyı kurcalasa bile aşamaz.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Hocalar Firebase konsolundan elle eklenir: teachers/{hocanın uid'i}
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function pad(n) {
      return (n < 10 ? '0' : '') + string(n);
    }

    // Sunucu saatine göre Türkiye saati (UTC+3)
    function nowTR() {
      return request.time + duration.value(3, 'h');
    }

    // Bugünün tarihi: "YYYY-AA-GG"
    function todayTR() {
      let t = nowTR();
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }

    // Gece yarısından beri geçen dakika
    function nowMin() {
      let t = nowTR();
      return t.hours() * 60 + t.minutes();
    }

    // 1 = Pazartesi … 7 = Pazar
    function todayDow() {
      return nowTR().dayOfWeek();
    }

    // Hoca "Yoklamayı kapat" demediyse yoklama açıktır
    function sessionOpen(sid) {
      let path = /databases/$(database)/documents/sessions/$(sid);
      return !exists(path) || get(path).data.open == true;
    }

    // Ders bugün var mı ve şu an yoklama penceresinde mi?
    // (ders başlamadan 15 dk önce açılır, ders bitince kapanır)
    function lessonNow(lessonId, lessonName) {
      let l = get(/databases/$(database)/documents/lessons/$(lessonId)).data;
      return lessonName == l.name
        && todayDow() in l.days
        && nowMin() >= l.startMin - 15
        && nowMin() <= l.endMin;
    }

    function validLesson(d) {
      return d.keys().hasOnly(['name', 'teacherId', 'teacherName', 'days', 'startMin', 'endMin', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.teacherId is string
        && d.teacherName is string && d.teacherName.size() <= 60
        && d.days is list && d.days.size() > 0 && d.days.size() <= 7
        && d.startMin is int && d.endMin is int
        && d.startMin >= 0 && d.endMin <= 1439 && d.startMin < d.endMin;
    }

    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // lessons/{id} → { name, teacherId, teacherName, days: [1..7], startMin, endMin }
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create: if isTeacher()
        && validLesson(request.resource.data)
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && validLesson(request.resource.data);
      allow delete: if isTeacher();
    }

    // sessions/{tarih_ders} → { open: true/false }
    match /sessions/{sid} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // attendance/{tarih_ders_uid}
    match /attendance/{id} {
      // Hoca hepsini görür; öğrenci sadece kendi kayıtlarını
      allow get: if isTeacher()
        || (signedIn() && id.matches('.*_' + request.auth.uid));
      allow list: if isTeacher()
        || (signedIn() && resource.data.uid == request.auth.uid);

      // Öğrenci: sadece kendi adına, sadece bugün ve ders saatinde,
      // sadece sunucu saatiyle, "bekliyor" durumunda ve yoklama açıksa.
      // E-postası doğrulanmamış hesap giriş yapamaz.
      // Belge kimliği sabit olduğu için aynı derse ikinci kez giriş yapılamaz.
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'photo', 'date', 'lessonId', 'lessonName', 'checkedInAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == request.auth.token.get('name', '')
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('^$|^https://[a-z0-9.-]+\\.googleusercontent\\.com/.{1,500}$')
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.matches('^[A-Za-z0-9]{1,40}$')
        && request.resource.data.date == todayTR()
        && request.resource.data.checkedInAt == request.time
        && request.resource.data.status == 'pending'
        && id == todayTR() + '_' + request.resource.data.lessonId + '_' + request.auth.uid
        && lessonNow(request.resource.data.lessonId, request.resource.data.lessonName)
        && sessionOpen(todayTR() + '_' + request.resource.data.lessonId);

      // Onay / ret sadece hocada; giriş saati ve isim değiştirilemez
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];

      // Kimse silemez (iz kalsın)
      allow delete: if false;
    }
  }
}
