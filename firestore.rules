rules_version = '2';

// Derstayım – English Time yoklama kuralları.
// Uygulama kodu ne yaparsa yapsın, bu kurallar Google sunucusunda çalışır;
// öğrenci tarayıcıyı kurcalasa bile aşamaz.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Hocalar Firebase konsolundan elle eklenir: teachers/{hocanın uid'i}
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function pad(n) {
      return (n < 10 ? '0' : '') + string(n);
    }

    // Sunucu saatine göre Türkiye saati (UTC+3)
    function nowTR() {
      return request.time + duration.value(3, 'h');
    }

    // Bugünün tarihi: "YYYY-AA-GG"
    function todayTR() {
      let t = nowTR();
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }

    // Şu an ders saati mi? Varsayılan: hafta içi 18:50–22:00 (public/config.js ile aynı).
    // İstenirse settings/schedule belgesiyle değiştirilebilir (günler 1 = Pazartesi … 7 = Pazar,
    // dakika cinsinden başlangıç/bitiş). Yoklama 15 dk önce açılır.
    function classNow() {
      let t = nowTR();
      let m = t.hours() * 60 + t.minutes();
      let path = /databases/$(database)/documents/settings/schedule;
      let s = exists(path) ? get(path).data : { 'days': [1, 2, 3, 4, 5], 'startMin': 1130, 'endMin': 1320 };
      return t.dayOfWeek() in s.days && m >= s.startMin - 15 && m <= s.endMin;
    }

    // Hoca "Yoklamayı kapat" demediyse yoklama açıktır
    function sessionOpen(sid) {
      let path = /databases/$(database)/documents/sessions/$(sid);
      return !exists(path) || get(path).data.open == true;
    }

    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // settings/schedule → { days: [1..5], startMin, endMin } (isteğe bağlı; yoksa varsayılan saat)
    match /settings/schedule {
      allow read: if signedIn();
      allow write: if isTeacher()
        && request.resource.data.keys().hasOnly(['days', 'startMin', 'endMin'])
        && request.resource.data.days is list && request.resource.data.days.size() > 0
        && request.resource.data.startMin is int && request.resource.data.endMin is int
        && request.resource.data.startMin >= 0 && request.resource.data.endMin <= 1439
        && request.resource.data.startMin < request.resource.data.endMin;
    }

    // sessions/{tarih} → { open: true/false }
    match /sessions/{sid} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // profiles/{uid} → { photo: "data:image/jpeg;base64,...", updatedAt }
    // Fotoğrafı sadece sahibi değiştirir; sahibi ve hocalar görür.
    match /profiles/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 200000
        && request.resource.data.photo.matches('^data:image/jpeg;base64,.+')
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // attendance/{tarih_uid}
    match /attendance/{id} {
      // Hoca hepsini görür; öğrenci sadece kendi kayıtlarını (geçmiş dahil)
      allow read: if isTeacher()
        || (signedIn() && id.matches('.*_' + request.auth.uid))
        || (signedIn() && resource.data.uid == request.auth.uid);

      // Öğrenci: sadece kendi adına, sadece bugün ve ders saatinde, sadece sunucu
      // saatiyle, "bekliyor" durumunda ve yoklama açıksa kayıt açabilir.
      // E-postası doğrulanmamış hesap giriş yapamaz.
      // Belge kimliği sabit olduğu için aynı gün ikinci kez giriş yapılamaz.
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'photo', 'date', 'checkedInAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == request.auth.token.get('name', '')
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('^$|^https://[a-z0-9.-]+\\.googleusercontent\\.com/.{1,500}$')
        && request.resource.data.date == todayTR()
        && request.resource.data.checkedInAt == request.time
        && request.resource.data.status == 'pending'
        && id == todayTR() + '_' + request.auth.uid
        && classNow()
        && sessionOpen(todayTR());

      // Onay / ret sadece hocada; giriş saati ve isim değiştirilemez
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];

      // Kimse silemez (iz kalsın)
      allow delete: if false;
    }
  }
}
